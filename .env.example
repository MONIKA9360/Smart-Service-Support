# ─────────────────────────────────────────────────────────────────────────────
# Smart Service & Support Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_support
DB_USERNAME=support_user
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api

# ── File Storage ──────────────────────────────────────────────────────────────
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=10

# ── MySQL Docker ──────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=smart_support
MYSQL_USER=support_user
MYSQL_PASSWORD=
